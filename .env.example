# Copy to .env (gitignored) and fill in. Used only by src/export/export_gold.py.

# Workspace host without https://
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com

# Personal access token. Do not commit .env.
DATABRICKS_TOKEN=

# SQL warehouse HTTP path from Connection details:
#   /sql/1.0/warehouses/<id>
# A copied browser URL /sql/warehouses/<id>?o=... is also accepted.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/
